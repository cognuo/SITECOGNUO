---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const checklist = [
  'A gente entende como sua operação funciona hoje',
  'Identificamos onde está custando mais caro',
  'Mostramos o que dá para resolver e como',
  'Estimativa de prazo e investimento',
];

const inputClass =
  'w-full rounded-xl border border-secondary/15 bg-white px-4 py-3 text-[0.95rem] text-secondary placeholder:text-secondary/40 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20';
---

<Layout
  title="Contato | Cognuo"
  description="Agende um diagnóstico gratuito de 45 minutos. A gente entende sua operação e diz honestamente o que dá para resolver."
  canonical="https://cognuo.com.br/contato"
>
  <Navbar />

  <!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero-root relative overflow-hidden flex flex-col" style="background: radial-gradient(125% 120% at 78% -10%, #12409e 0%, #0a1c47 40%, #0a0c14 73%, #080808 100%);">
    <div class="absolute inset-0 hero-grid-cols" aria-hidden="true"></div>
    <div class="absolute inset-0 hero-grid-dots opacity-60" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-accent-line" aria-hidden="true"></div>

    <div class="relative z-10 px-6 pt-36 pb-20 lg:pt-40 lg:pb-24 text-center max-w-3xl mx-auto">
      <div class="anim-hero anim-d1 inline-flex items-center gap-2.5 mb-8">
        <span class="w-6 h-px bg-off-white/35" aria-hidden="true"></span>
        <span class="text-[10.5px] font-semibold tracking-[0.2em] uppercase text-off-white/75">Contato</span>
        <span class="w-6 h-px bg-off-white/35" aria-hidden="true"></span>
      </div>
      <h1 class="anim-hero anim-d2 text-[clamp(2.1rem,4.6vw,3.6rem)] font-extrabold text-off-white leading-[1.08] tracking-[-0.025em] mb-6 max-w-[20ch] mx-auto">
        Vamos entender o seu problema antes de <span class="hl-grad">falar em solução</span>
      </h1>
      <p class="anim-hero anim-d3 text-[1.02rem] sm:text-[1.08rem] text-off-white/70 max-w-[560px] mx-auto leading-[1.7]">
        Em 45 minutos, você conta como sua operação funciona hoje e onde está
        travando. A gente ouve, faz as perguntas certas e diz honestamente o que
        dá para resolver. Sem compromisso, sem pressão.
      </p>
    </div>
  </section>

  <!-- ═══ CONTACT ════════════════════════════════════════════════════ -->
  <section class="bg-off-white py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-6 lg:px-10 grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-start">

      <!-- Form -->
      <div data-animate>
        <h2 class="text-[clamp(1.5rem,2.4vw,2rem)] font-bold text-secondary tracking-tight mb-2">
          Conte o que está travando
        </h2>
        <p class="text-secondary/65 text-[0.97rem] leading-relaxed mb-8">
          Responda em 24h. Quanto mais contexto você der, mais certeira a conversa.
        </p>

        <form id="contato-form" class="grid gap-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="nome" class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-secondary/55 mb-2">Nome</label>
              <input id="nome" name="nome" type="text" required placeholder="Seu nome" class={inputClass} />
            </div>
            <div>
              <label for="empresa" class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-secondary/55 mb-2">Empresa</label>
              <input id="empresa" name="empresa" type="text" placeholder="Nome da empresa" class={inputClass} />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-secondary/55 mb-2">E-mail</label>
              <input id="email" name="email" type="email" required placeholder="voce@empresa.com" class={inputClass} />
            </div>
            <div>
              <label for="telefone" class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-secondary/55 mb-2">Telefone / WhatsApp</label>
              <input id="telefone" name="telefone" type="tel" placeholder="(00) 00000-0000" class={inputClass} />
            </div>
          </div>
          <div>
            <label for="mensagem" class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-secondary/55 mb-2">O que está acontecendo?</label>
            <textarea id="mensagem" name="mensagem" rows="5" required placeholder="Ex: minha equipe refaz o mesmo trabalho todo dia e nada conversa entre si..." class={inputClass}></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 mt-2">
            <button type="button" id="wa-btn" class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-full bg-[#25D366] text-[#053921] text-sm font-bold hover:bg-[#20c75f] transition-colors duration-200" style="box-shadow: 0 14px 30px -12px rgba(37,211,102,0.55);">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.523 5.26l-.999 3.648 3.965-1.039zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
              </svg>
              <span>Enviar pelo WhatsApp</span>
            </button>
            <button type="submit" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-primary text-white text-sm font-bold hover:bg-[#0040d4] transition-colors duration-200" style="box-shadow: 0 14px 30px -12px rgba(0,53,176,0.5);">
              <span>Enviar por e-mail</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8m0 0L7 3m4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <p class="text-[11px] uppercase tracking-[0.15em] text-secondary/55 font-medium mt-1">Resposta em 24h · Sem compromisso</p>
          <p class="text-[12px] text-secondary/50 leading-relaxed mt-1">
            Prefere e-mail direto? <a href="mailto:contato@cognuo.com.br" class="text-primary border-b border-primary/40 hover:border-primary transition-colors">contato@cognuo.com.br</a>
          </p>
        </form>
      </div>

      <!-- Side panel -->
      <div class="bg-secondary rounded-2xl p-8 lg:p-9" data-animate data-animate-delay="2">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] mb-6" style="color: #A3BAEA;">Diagnóstico · 45 min</p>
        <ul class="space-y-4 mb-8">
          {checklist.map((item) => (
            <li class="flex items-start gap-3 text-[0.93rem] text-off-white/80 leading-snug">
              <span class="flex-shrink-0 w-5 h-5 mt-px rounded-full bg-primary/25 text-[#8fa9f5] inline-flex items-center justify-center text-[11px] font-bold" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))}
          <li class="flex items-start gap-3 pt-4 border-t border-off-white/10 text-[0.93rem] font-medium text-off-white leading-snug">
            <span class="flex-shrink-0 w-5 h-5 mt-px rounded-full bg-primary text-white inline-flex items-center justify-center text-[11px] font-bold" aria-hidden="true">→</span>
            <span>Você sai com clareza, mesmo que não feche nada.</span>
          </li>
        </ul>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] uppercase tracking-[0.15em] text-off-white/65 font-medium">
          <span>Gratuito</span>
          <span class="w-px h-3 bg-off-white/28" aria-hidden="true"></span>
          <span>Sem compromisso</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const WHATSAPP_NUMBER = '5511991203467';
  const form = document.getElementById('contato-form') as HTMLFormElement | null;
  const waBtn = document.getElementById('wa-btn');

  const field = (k: string) =>
    String(new FormData(form as HTMLFormElement).get(k) || '').trim();

  // Fire a deduplicated Meta Lead event (matches the Conversions API handler).
  const trackLead = () => {
    const eventId = 'ev_' + Date.now() + '_' + Math.random().toString(36).slice(2, 9);
    if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'Lead', {}, { eventID: eventId });
    }
  };

  // E-mail channel
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const subject = `Diagnóstico · ${field('nome')}${field('empresa') ? ' — ' + field('empresa') : ''}`;
    const body = [
      `Nome: ${field('nome')}`,
      `Empresa: ${field('empresa')}`,
      `E-mail: ${field('email')}`,
      `Telefone/WhatsApp: ${field('telefone')}`,
      '',
      'Mensagem:',
      field('mensagem'),
    ].join('\n');

    trackLead();
    window.location.href =
      `mailto:contato@cognuo.com.br?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  // WhatsApp channel — sends the typed message, prefixed with name/company when present.
  waBtn?.addEventListener('click', () => {
    const nome = field('nome');
    const empresa = field('empresa');
    const mensagem = field('mensagem');

    let text;
    if (mensagem) {
      const intro = nome
        ? `Olá! Sou ${nome}${empresa ? ' da ' + empresa : ''}. `
        : 'Olá! ';
      text = intro + mensagem;
    } else {
      text = 'Olá! Gostaria de agendar um diagnóstico gratuito.';
    }

    trackLead();
    window.open(
      `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`,
      '_blank',
      'noopener',
    );
  });
</script>
